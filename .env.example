# --- Base de datos (PostgreSQL) ---
# Neon la entrega como postgresql://usuario:password@host/db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peso?schema=public"

# --- Sesion (NextAuth v5) ---
# URL publica de la app: http://localhost:3000 en local, el dominio del proyecto en Vercel.
NEXTAUTH_URL="http://localhost:3000"
# Secreto para firmar los JWT. Genera uno con: openssl rand -base64 32
AUTH_SECRET=""

# --- Opcional: login con Google ---
# Si no definis las dos, el boton de Google no se muestra en la pantalla de login.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
